DATABASE_URL=postgresql+psycopg://ml_user:ml_password@localhost:5432/ml_learning
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_RECYCLE=300
CORS_ORIGINS=http://localhost:4200
# Exact browser origins (no path or trailing slash). Add the LAN URL for phone testing.
# If omitted, defaults to CORS_ORIGINS. See docs/seguridad-solicitudes.md.
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=7
PASSWORD_LOGIN_MAX_ATTEMPTS=8
PASSWORD_LOGIN_WINDOW_SECONDS=300
# API request bodies only, in bytes (64 KiB); not maps/images or response sizes.
API_MAX_REQUEST_BYTES=65536

# Public template only. Copy to .env.ec2 on EC2 and chmod 600; never commit secrets.
# Standalone compose.production.yml; never combine with development compose.yml.
APP_VERSION=REPLACE_WITH_RELEASE_ID
PUBLIC_ORIGIN=https://REPLACE_WITH_PUBLIC_IPV4
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
TLS_DIR=/srv/exploralab/tls
POSTGRES_DB=exploralab
POSTGRES_USER=exploralab
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_PASSWORD
# Keep Google disabled for the IP-only demonstration. Use email/password.
GOOGLE_CLIENT_ID=
WEB_CONCURRENCY=2

# Copy to .env.production, keep private, never commit it or print compose config.
# This defaults to loopback, not an Internet deployment.
APP_VERSION=local-20261007
PUBLIC_ORIGIN=https://localhost:8443
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
TLS_DIR=./infra/.local/tls
POSTGRES_DB=exploralab
POSTGRES_USER=exploralab
POSTGRES_PASSWORD=CHANGE_ME_USE_A_RANDOM_PASSWORD_AT_LEAST_24_CHARACTERS
# Public OAuth ID, not a client secret. Must match the compiled frontend.
# Leave empty to disable Google; authorize the real HTTPS origin in Google first.
GOOGLE_CLIENT_ID=
WEB_CONCURRENCY=2
